DATABASE_URL=postgresql://user:password@localhost:5432/exam_portal
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
GROQ_API_KEY=optional_groq_api_key_14400_free_requests_per_day
GEMINI_API_KEY=optional_gemini_api_key_1500_free_requests_per_day
OPENAI_API_KEY=optional_openai_api_key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Email Configuration for Password Reset & Notifications (Optional - falls back to simulated/dev mode if omitted)
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character Google App Password (not your personal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

